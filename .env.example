# Copy to .env.local and fill in. Never commit real values.

# GitHub OAuth app (github.com/settings/developers)
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client, optional (console.cloud.google.com → APIs & Services → Credentials,
# "Web application"). Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Leave both empty to offer GitHub sign-in only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Neon Postgres connection string
DATABASE_URL=

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Inngest (background sync). Local dev: set INNGEST_DEV=1 and run `pnpm inngest:dev`.
# Production: leave INNGEST_DEV unset and fill both keys from the Inngest dashboard.
INNGEST_DEV=1
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
