{
  "manifest_version": 3,
  "name": "CodeLogs",
  "version": "0.4.0",
  "description": "Syncs the problems you solve on coding sites to your CodeLogs dashboard, from the browser you are already logged in with.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "scripting", "alarms"],
  "host_permissions": ["https://leetcode.com/*", "https://codelogs.techsavy.space/*"],
  "optional_host_permissions": [
    "https://codeforces.com/*",
    "https://atcoder.jp/*",
    "https://www.codechef.com/*",
    "https://www.naukri.com/*",
    "https://www.hackerrank.com/*",
    "https://www.interviewbit.com/*",
    "https://www.geeksforgeeks.org/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CodeLogs",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
