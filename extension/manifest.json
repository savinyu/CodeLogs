{
  "manifest_version": 3,
  "name": "CodeLogs",
  "version": "0.3.0",
  "description": "Keeps your solved problems from LeetCode, CodeChef, Code360, HackerRank, InterviewBit and GeeksforGeeks in sync with CodeLogs.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "scripting", "alarms"],
  "host_permissions": ["https://leetcode.com/*", "http://localhost:3000/*"],
  "optional_host_permissions": [
    "https://www.codechef.com/*",
    "https://www.naukri.com/*",
    "https://www.hackerrank.com/*",
    "https://www.interviewbit.com/*",
    "https://www.geeksforgeeks.org/*",
    "https://*/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CodeLogs",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
